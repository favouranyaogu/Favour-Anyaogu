# Spotify "Now Playing" integration.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. In the app settings, add this exact Redirect URI (Spotify rejects `localhost`;
#    loopback must be an explicit 127.0.0.1 literal):
#        http://127.0.0.1:3000/api/spotify/callback
#    (use whatever port you run `npm run dev` on)
# 3. Put the Client ID and Client Secret below, then run `npm run dev` and visit:
#        http://127.0.0.1:3000/api/spotify/login
#    That completes the Authorization Code flow and writes SPOTIFY_REFRESH_TOKEN
#    into .env.local for you. Restart the dev server afterwards.
#
# Copy this file to .env.local and fill in the values. Never commit .env.local.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: override the redirect URI (e.g. when running on a non-default port or
# behind a tunnel). Must match the Spotify dashboard exactly.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
